# Generated from src/platform/config/env.ts — keep in sync.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres connection string (required)
DATABASE_URL=postgresql://policyaction:policyaction@localhost:5432/policyaction

# S3-compatible object storage (required)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=policyaction
S3_FORCE_PATH_STYLE=true

# Python parser sidecar
SIDECAR_URL=http://localhost:8000

LOG_LEVEL=info

# Introduced in later modules
# OPENSTATES_API_KEY=      # Module 1 — legislative metadata

# Live model gateway — when both MODEL_PROVIDER and MODEL_API_KEY are set,
# the system uses a live LLM for span extraction and support evaluation.
# Without these, FixtureModelGateway is used (sufficient for tests only).
# MODEL_PROVIDER=anthropic   # "anthropic" or "openai"
# MODEL_API_KEY=sk-ant-...
# MODEL_BASE_URL=            # optional — defaults to provider's standard URL
# MODEL_ID=claude-sonnet-4-20250514
# EVALUATOR_MODEL_ID=claude-haiku-4-5-20251001  # must differ from MODEL_ID
